# Selenium Grid / node / video image version.
# Keep this in sync across hub, chrome, firefox, and video images to avoid
# protocol/capability mismatches between the hub and its nodes.
SELENIUM_VERSION=4.41.0-20260222

# Chrome image selection
# amd64 (default — no change needed):
#   CHROME_IMAGE_NAME=selenium/node-chrome
#
# arm64 (Apple Silicon / Linux ARM):
#   CHROME_IMAGE_NAME=selenium/node-chromium
CHROME_IMAGE_NAME=selenium/node-chrome

# Video recording
# Uncomment to spin up chrome_video, firefox_video, and file_browser services.
# COMPOSE_PROFILES=video
