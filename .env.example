# Chrome image selection
# amd64 (default — no change needed):
#   CHROME_IMAGE=selenium/node-chrome:latest
#
# arm64 (Apple Silicon / Linux ARM):
#   CHROME_IMAGE=selenium/node-chromium:latest
CHROME_IMAGE=selenium/node-chrome:latest

# Video recording
# Uncomment to spin up chrome_video, firefox_video, and file_browser services.
# COMPOSE_PROFILES=video
